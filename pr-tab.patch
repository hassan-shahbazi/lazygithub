+func TestParseMergeMethods(t *testing.T) {
+	cases := []struct {
+		name     string
+		body     string
+		expected []string
+		wantErr  bool
+	}{
+		{
+			name:     "all allowed with default MERGE",
+			body:     `{"data":{"repository":{"mergeCommitAllowed":true,"squashMergeAllowed":true,"rebaseMergeAllowed":true,"viewerDefaultMergeMethod":"MERGE"}}}`,
+			expected: []string{"MERGE", "SQUASH", "REBASE"},
+		},
+		{
+			name:     "all allowed with default SQUASH",
+			body:     `{"data":{"repository":{"mergeCommitAllowed":true,"squashMergeAllowed":true,"rebaseMergeAllowed":true,"viewerDefaultMergeMethod":"SQUASH"}}}`,
+			expected: []string{"SQUASH", "MERGE", "REBASE"},
+		},
+		{
+			name:     "all allowed with default REBASE",
+			body:     `{"data":{"repository":{"mergeCommitAllowed":true,"squashMergeAllowed":true,"rebaseMergeAllowed":true,"viewerDefaultMergeMethod":"REBASE"}}}`,
+			expected: []string{"REBASE", "MERGE", "SQUASH"},
+		},
+		{
+			name:     "squash and rebase with default SQUASH",
+			body:     `{"data":{"repository":{"mergeCommitAllowed":false,"squashMergeAllowed":true,"rebaseMergeAllowed":true,"viewerDefaultMergeMethod":"SQUASH"}}}`,
+			expected: []string{"SQUASH", "REBASE"},
+		},
+		{
+			name:     "default REBASE disallowed",
+			body:     `{"data":{"repository":{"mergeCommitAllowed":true,"squashMergeAllowed":true,"rebaseMergeAllowed":false,"viewerDefaultMergeMethod":"REBASE"}}}`,
+			expected: []string{"MERGE", "SQUASH"},
+		},
+		{
+			name:    "graphql errors",
+			body:    `{"errors":[{"message":"boom"}]}`,
+			wantErr: true,
+		},
+		{
+			name:    "null repository",
+			body:    `{"data":{"repository":null}}`,
+			wantErr: true,
+		},
+		{
+			name:    "none allowed",
+			body:    `{"data":{"repository":{"mergeCommitAllowed":false,"squashMergeAllowed":false,"rebaseMergeAllowed":false,"viewerDefaultMergeMethod":"MERGE"}}}`,
+			wantErr: true,
+		},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			result, err := parseMergeMethods([]byte(c.body))
+			if c.wantErr {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+				assert.Equal(t, c.expected, result)
+			}
+		})
+	}
+}
