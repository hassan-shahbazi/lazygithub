+// FetchMergeMethods fetches the merge methods allowed for the repository.
+func (self *GitHubCommands) FetchMergeMethods(baseRemote *models.Remote, token string) ([]string, error) {
+	repoOwner, repoName, err := self.GetBaseRepoOwnerAndName(baseRemote)
+	if err != nil {
+		return nil, err
