+// lineCommentRange maps a selected patch line range to the GitHub PR line
+// comment parameters. It fails if the range contains lines that have no
+// position in the new file (deletions, headers, etc).
+func lineCommentRange(lines []*patch.PatchLine, start, end int, lineNumber func(int) int) (startLine int, line int, ok bool) {
+	for i := start; i <= end; i++ {
+		kind := lines[i].Kind
+		if kind != patch.ADDITION && kind != patch.CONTEXT {
+			return 0, 0, false
+		}
+	}
+	line = lineNumber(end)
+	if start < end {
+		startLine = lineNumber(start)
+	}
+	return startLine, line, true
+}
