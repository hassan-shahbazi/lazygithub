+// buildOpenPullRequestsSearch builds the GitHub search query for the PR list.
+// An empty filter means "is:open"; sort:updated-desc is added unless the filter already sorts.
+func buildOpenPullRequestsSearch(owner, name, filter string) string {
+	if strings.TrimSpace(filter) == "" {
+		filter = "is:open"
+	}
+	if !hasSortTerm(filter) {
+		filter += " sort:updated-desc"
+	}
+	return fmt.Sprintf("repo:%s/%s is:pr %s", owner, name, filter)
+}
+
+func hasSortTerm(filter string) bool {
+	for _, term := range strings.Fields(filter) {
+		if strings.HasPrefix(term, "sort:") {
+			return true
+		}
+	}
+	return false
+}
+
+type OpenPullRequestsResponse struct {
+	Errors []graphQLError `json:"errors"`
+	Data   struct {
+		Viewer struct {
+			Login string `json:"login"`
+		} `json:"viewer"`
+		Search struct {
+			Nodes []PullRequestNode `json:"nodes"`
+		} `json:"search"`
+	} `json:"data"`
+}
+
+func parseOpenPullRequests(body []byte) ([]*models.GithubPullRequest, error) {
+	var result OpenPullRequestsResponse
+	if err := json.Unmarshal(body, &result); err != nil {
+		return nil, err
+	}
+
+	if len(result.Errors) > 0 {
+		if err := repoNotFoundError(result.Errors); err != nil {
+			return nil, err
+		}
+		messages := make([]string, len(result.Errors))
+		for i, e := range result.Errors {
+			messages[i] = e.Message
+		}
+		return nil, fmt.Errorf("GitHub GraphQL error: %s", strings.Join(messages, "; "))
+	}
+
+	viewer := result.Data.Viewer.Login
+	prs := []*models.GithubPullRequest{}
+	for _, node := range result.Data.Search.Nodes {
+		assignedToMe := false
+		for _, a := range node.Assignees.Nodes {
+			if a.Login == viewer {
+				assignedToMe = true
+			}
+		}
+		for _, r := range node.ReviewRequests.Nodes {
+			if r.RequestedReviewer != nil && r.RequestedReviewer.Login == viewer {
+				assignedToMe = true
+			}
+		}
+
+		checksState := ""
+		if len(node.Commits.Nodes) > 0 && node.Commits.Nodes[0].Commit != nil && node.Commits.Nodes[0].Commit.StatusCheckRollup != nil {
+			checksState = node.Commits.Nodes[0].Commit.StatusCheckRollup.State
+		}
+
+		prs = append(prs, &models.GithubPullRequest{
+			HeadRefName: node.HeadRefName,
+			Number:      node.Number,
+			NodeID:      node.ID,
+			Title:       node.Title,
+			State:       lo.Ternary(node.IsDraft && node.State != "CLOSED", "DRAFT", node.State),
+			Url:         node.Url,
+			Author:      node.Author.Login,
+			HeadRepositoryOwner: models.GithubRepositoryOwner{
+				Login: node.HeadRepositoryOwner.Login,
+			},
+			ReviewDecision: node.ReviewDecision,
+			ChecksState:    checksState,
+			AssignedToMe:   assignedToMe,
+		})
+	}
+
+	return prs, nil
+}
