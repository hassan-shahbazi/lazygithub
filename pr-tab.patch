+func authorLogin(a *models.GithubRepositoryOwner) string {
+	if a == nil {
+		return "ghost"
+	}
+	return a.Login
+}
+
+func parseCreatedAt(s string) time.Time {
+	t, _ := time.Parse(time.RFC3339, s)
+	return t
+}
+
+func hiddenReason(isMinimized bool, reason string) string {
+	if !isMinimized {
+		return ""
+	}
+	h := strings.ToLower(strings.ReplaceAll(reason, "_", "-"))
+	if h == "" {
+		h = "hidden"
+	}
+	return h
+}
