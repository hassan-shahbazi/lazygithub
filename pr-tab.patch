+func (self *PullRequestsController) GetOnFocus() func(types.OnFocusOpts) {
+	return func(opts types.OnFocusOpts) {
+		if !self.c.UserConfig().Git.PullRequests.Enabled {
+			return
+		}
+		if !self.c.Helpers().Refresh.OpenPullRequestsFailed() {
+			return
+		}
+		self.c.OnWorker(func(gocui.Task) error {
+			err := self.c.Helpers().Refresh.RefreshOpenPullRequests()
+			if err != nil {
+				self.c.LogAction(fmt.Sprintf("Error fetching open pull requests from GitHub: %s", err.Error()))
+			}
+			return nil
+		})
+	}
+}
+
+func (self *PullRequestsController) renderDetails(d *models.GithubPullRequestDetails, width int) string {
+	if _, err := exec.LookPath("glow"); err != nil {
+		return ""
+	}
+	args := []string{"glow", "-s", self.c.UserConfig().Git.PullRequests.Style, "-w", strconv.Itoa(max(width, 40)), "-"}
+	out, err := self.c.OS().Cmd.New(args).SetStdin(presentation.FormatPullRequestDetailsMarkdown(d)).AddEnvVars("CLICOLOR_FORCE=1").DontLog().RunWithOutput()
+	if err != nil {
+		return ""
+	}
+	return out
+}
+
+func (self *PullRequestsController) loadDetails(number int) {
+	if self.loadingDetails[number] {
+		return
+	}
+	self.loadingDetails[number] = true
+
+	width := self.c.Views().Main.InnerWidth()
+
+	self.c.OnWorker(func(gocui.Task) error {
+		d, err := self.c.Helpers().Refresh.FetchPullRequestDetails(number)
+		var rendered string
+		if err == nil {
+			rendered = self.renderDetails(d, width)
+		}
+		self.c.OnUIThread(func() error {
+			delete(self.loadingDetails, number)
+			if err != nil {
+				self.c.ErrorToast(err.Error())
+				return nil
+			}
+			if self.c.Model().PullRequestDetails == nil {
+				self.c.Model().PullRequestDetails = map[int]*models.GithubPullRequestDetails{}
+			}
+			self.c.Model().PullRequestDetails[number] = d
+			if rendered != "" {
+				self.renderedDetails[number] = rendered
+			}
+			if sel := self.context().GetSelected(); sel != nil && sel.Number == number {
+				self.context().HandleRenderToMain()
+			}
+			return nil
+		})
+		return nil
+	})
+}
+
+func (self *PullRequestsController) refreshDetails(pr *models.GithubPullRequest) error {
+	delete(self.c.Model().PullRequestDetails, pr.Number)
+	delete(self.renderedDetails, pr.Number)
+	self.context().HandleRenderToMain()
+	return nil
+}
+
+func (self *PullRequestsController) afterMutation(pr *models.GithubPullRequest, toast string) {
+	self.c.OnUIThread(func() error {
+		self.c.Toast(toast)
+		return self.refreshDetails(pr)
+	})
+}
+
+func (self *PullRequestsController) addComment(pr *models.GithubPullRequest) error {
+	return openCommentPanel(self.c, self.c.Tr.AddPullRequestComment, func(text string) error {
+		return self.sendComment(pr, text)
+	})
+}
+
+func (self *PullRequestsController) addCommentInEditor(pr *models.GithubPullRequest) error {
+	path, err := newCommentFile(self.c)
+	if err != nil {
+		return err
+	}
+	return commentInEditor(self.c, path, func(text string) error {
+		return self.sendComment(pr, text)
+	})
+}
+
+func (self *PullRequestsController) sendComment(pr *models.GithubPullRequest, text string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.SendingPullRequestComment, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.AddPullRequestComment(pr.NodeID, text); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestCommentSent)
+		return nil
+	})
+}
+
+// openCommentPanel reuses the commit message panel for a multiline comment.
+func openCommentPanel(c *ControllerCommon, title string, send func(body string) error) error {
+	c.Helpers().Commits.OpenCommitMessagePanel(&helpers.OpenCommitMessagePanelOpts{
+		CommitIndex:      context.NoCommitIndex,
+		SummaryTitle:     title,
+		DescriptionTitle: c.Tr.PullRequestCommentBodyTitle,
+		PreserveMessage:  false,
+		OnConfirm: func(summary string, description string) error {
+			if c.UserConfig().Git.Commit.AutoWrapCommitMessage {
+				description = helpers.TryRemoveHardLineBreaks(description, c.UserConfig().Git.Commit.AutoWrapWidth)
+			}
+			body := summary
+			if description != "" {
+				body = summary + "\n\n" + description
+			}
+			return send(body)
+		},
+		OnSwitchToEditor: func(path string) error {
+			return commentInEditor(c, path, send)
+		},
+	})
+	return nil
+}
+
+// commentInEditor edits the file in $EDITOR and sends its content.
+func commentInEditor(c *ControllerCommon, path string, send func(body string) error) error {
+	if err := c.Helpers().Files.EditFileAtLineAndWait(path, 1); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	_ = os.Remove(path)
+	text := strings.TrimSpace(string(data))
+	if text == "" {
+		return nil
+	}
+	return send(text)
+}
+
+func newCommentFile(c *ControllerCommon) (string, error) {
+	path := filepath.Join(c.OS().GetTempDir(), c.Git().RepoPaths.RepoName(), "pr-comment-"+time.Now().Format("20060102-150405.000000000")+".md")
+	return path, c.OS().CreateFileWithContent(path, "")
+}
+
+func (self *PullRequestsController) review(pr *models.GithubPullRequest) error {
+	return self.c.Menu(types.CreateMenuOptions{
+		Title: self.c.Tr.ReviewPullRequest,
+		Items: []*types.MenuItem{
+			{
+				Label: self.c.Tr.ApprovePullRequest,
+				OnPress: func() error {
+					self.c.Confirm(types.ConfirmOpts{
+						Title:  self.c.Tr.ReviewPullRequest,
+						Prompt: fmt.Sprintf(self.c.Tr.ConfirmApprovePullRequest, pr.Number),
+						HandleConfirm: func() error {
+							return self.submitReview(pr, "APPROVE", "")
+						},
+					})
+					return nil
+				},
+			},
+			{
+				Label: self.c.Tr.RequestChangesPullRequest,
+				OnPress: func() error {
+					self.c.Prompt(types.PromptOpts{
+						Title: self.c.Tr.RequestChangesBody,
+						HandleConfirm: func(text string) error {
+							if strings.TrimSpace(text) == "" {
+								return errors.New(self.c.Tr.RequestChangesBody)
+							}
+							return self.submitReview(pr, "REQUEST_CHANGES", text)
+						},
+					})
+					return nil
+				},
+			},
+		},
+	})
+}
+
+func (self *PullRequestsController) canMerge(pr *models.GithubPullRequest) *types.DisabledReason {
+	if pr.State != "OPEN" {
+		return &types.DisabledReason{Text: self.c.Tr.PullRequestNotOpen}
+	}
+	return nil
+}
+
+func (self *PullRequestsController) merge(pr *models.GithubPullRequest) error {
+	self.c.WithWaitingStatus(self.c.Tr.FetchingMergeMethods, func(gocui.Task) error {
+		methods, err := self.c.Helpers().Refresh.FetchPullRequestMergeMethods()
+		if err != nil {
+			return err
+		}
+		self.c.OnUIThread(func() error {
+			labels := map[string]string{
+				"MERGE":  self.c.Tr.MergeCommitMethod,
+				"SQUASH": self.c.Tr.SquashMergeMethod,
+				"REBASE": self.c.Tr.RebaseMergeMethod,
+			}
+			items := make([]*types.MenuItem, 0, len(methods))
+			for _, method := range methods {
+				label := labels[method]
+				items = append(items, &types.MenuItem{
+					Label: label,
+					OnPress: func() error {
+						self.c.Confirm(types.ConfirmOpts{
+							Title:  self.c.Tr.MergePullRequest,
+							Prompt: fmt.Sprintf(self.c.Tr.ConfirmMergePullRequest, pr.Number, label),
+							HandleConfirm: func() error {
+								return self.submitMerge(pr, method)
+							},
+						})
+						return nil
+					},
+				})
+			}
+			return self.c.Menu(types.CreateMenuOptions{
+				Title: self.c.Tr.MergePullRequest,
+				Items: items,
+			})
+		})
+		return nil
+	})
+	return nil
+}
+
+func (self *PullRequestsController) submitMerge(pr *models.GithubPullRequest, method string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.MergingPullRequest, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.MergePullRequest(pr.NodeID, method); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestMerged)
+		return self.c.Helpers().Refresh.RefreshOpenPullRequests()
+	})
+}
+
+func (self *PullRequestsController) viewCommits(pr *models.GithubPullRequest) error {
+	remote := self.c.Helpers().Refresh.GithubBaseRemote()
+	if remote == nil {
+		return errors.New(self.c.Tr.NoGithubBaseRemote)
+	}
+
+	ref := &models.GithubPullRequestRef{Number: pr.Number, Title: pr.Title}
+
+	return self.c.WithWaitingStatus(self.c.Tr.FetchingPullRequest, func(task gocui.Task) error {
+		if err := self.c.Git().GitHub.FetchPullRequestRefCmdObj(task, remote.Name, pr.Number).Run(); err != nil {
+			return err
+		}
+
+		self.c.OnUIThread(func() error {
+			return self.c.Helpers().SubCommits.ViewSubCommits(helpers.ViewSubCommitsOpts{
+				Ref:             ref,
+				TitleRef:        ref.RefName() + " " + pr.Title,
+				Context:         self.context(),
+				ShowBranchHeads: true,
+			})
+		})
+		return nil
+	})
+}
+
+func (self *PullRequestsController) submitReview(pr *models.GithubPullRequest, event string, body string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.SubmittingPullRequestReview, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.SubmitPullRequestReview(pr.NodeID, event, body); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestReviewSubmitted)
+		return nil
+	})
+}
+
+func (self *PullRequestsController) confirmOpenInBrowser(pr *models.GithubPullRequest) error {
+	self.c.Confirm(types.ConfirmOpts{
+		Title:  self.c.Tr.OpenPullRequestInBrowser,
+		Prompt: fmt.Sprintf(self.c.Tr.ConfirmOpenPullRequest, pr.Number),
+		HandleConfirm: func() error {
+			return self.openInBrowser(pr)
+		},
+	})
+	return nil
+}
+
+func (self *PullRequestsController) checkout(pr *models.GithubPullRequest) error {
+	remote := self.c.Helpers().Refresh.GithubBaseRemote()
+	if remote == nil {
+		return errors.New(self.c.Tr.NoGithubBaseRemote)
+	}
+
+	owner, _, err := self.c.Git().GitHub.GetBaseRepoOwnerAndName(remote)
+	if err != nil {
+		return err
+	}
+
+	name := git_commands.PullRequestLocalBranchName(pr, owner)
+
+	if lo.ContainsBy(self.c.Model().Branches, func(branch *models.Branch) bool {
+		return branch.Name == name
+	}) {
+		return self.c.Helpers().Refs.CheckoutRef(name, types.CheckoutRefOptions{})
+	}
+
+	self.c.WithWaitingStatus(self.c.Tr.FetchingPullRequest, func(task gocui.Task) error {
+		self.c.LogAction(self.c.Tr.Actions.CheckoutPullRequest)
+
+		if err := self.c.Git().GitHub.FetchPullRequestCmdObj(task, remote.Name, pr.Number, name).Run(); err != nil {
+			return err
+		}
+
+		// CheckoutRef pushes the branches context, so it must run on the UI thread.
+		self.c.OnUIThread(func() error {
+			return self.c.Helpers().Refs.CheckoutRef(name, types.CheckoutRefOptions{})
+		})
+		return nil
+	})
+
+	return nil
+}
+
+func (self *PullRequestsController) openInBrowser(pr *models.GithubPullRequest) error {
+	self.c.LogAction(self.c.Tr.Actions.OpenPullRequest)
+
+	return self.c.OS().OpenLink(pr.Url)
+}
+
+func (self *PullRequestsController) detailsLoaded(pr *models.GithubPullRequest) *types.DisabledReason {
+	if self.c.Model().PullRequestDetails[pr.Number] == nil {
+		return &types.DisabledReason{Text: self.c.Tr.LoadingPullRequestDetails}
+	}
+	return nil
+}
+
+// openInEditor writes the details to lazygit's temp dir, which is removed on exit.
+func (self *PullRequestsController) openInEditor(pr *models.GithubPullRequest) error {
+	d := self.c.Model().PullRequestDetails[pr.Number]
+	path := filepath.Join(self.c.OS().GetTempDir(), self.c.Git().RepoPaths.RepoName(), fmt.Sprintf("pr-%d.md", pr.Number))
+	if err := self.c.OS().CreateFileWithContent(path, presentation.FormatPullRequestDetailsMarkdown(d)); err != nil {
+		return err
+	}
+	return self.c.Helpers().Files.EditFiles([]string{path})
+}
+
+func (self *PullRequestsController) copyURL(pr *models.GithubPullRequest) error {
+	self.c.LogAction(self.c.Tr.Actions.CopyPullRequestURL)
+	if err := self.c.OS().CopyToClipboard(pr.Url); err != nil {
+		return err
+	}
+
+	self.c.Toast(self.c.Tr.PullRequestURLCopiedToClipboard)
+
+	return nil
+}
+
+func (self *PullRequestsController) context() *context.PullRequestsContext {
+	return self.c.Contexts().PullRequests
+}
