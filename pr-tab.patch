+// lineCommentSend captures the selected line range and returns a send closure.
+func (self *PatchBuildingController) lineCommentSend() (func(string) error, error) {
+	pr := self.pullRequestForLineComment()
+	if pr == nil {
+		return nil, nil
+	}
+
+	self.context().GetMutex().Lock()
+	state := self.context().GetState()
+	var startLine, line int
+	var ok bool
+	var path, commit string
+	if state != nil {
+		start, end := state.SelectedPatchRange()
+		startLine, line, ok = lineCommentRange(state.PatchLines(), start, end, state.LineNumberOfPatchLine)
+		path = self.c.Contexts().CommitFiles.GetSelectedPath()
+		commit = self.c.Contexts().CommitFiles.GetRef().RefName()
+	}
+	self.context().GetMutex().Unlock()
+
+	if state == nil {
+		return nil, nil
+	}
+	if !ok {
+		return nil, errors.New(self.c.Tr.PRLineCommentDeletedLines)
+	}
+
+	return func(text string) error {
+		return self.c.WithWaitingStatus(self.c.Tr.SendingPullRequestComment, func(gocui.Task) error {
+			if err := self.c.Helpers().Refresh.AddPullRequestLineComment(pr.Number, git_commands.PullRequestLineComment{
+				CommitID:  commit,
+				Path:      path,
+				Body:      text,
+				Line:      line,
+				StartLine: startLine,
+			}); err != nil {
+				return err
+			}
+			self.c.Toast(self.c.Tr.PullRequestCommentSent)
+			return nil
+		})
+	}, nil
+}
+
