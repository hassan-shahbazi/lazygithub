diff --git a/pkg/gui/presentation/pull_requests.go b/pkg/gui/presentation/pull_requests.go
new file mode 100644
index 000000000..4f1ba576e
--- /dev/null
+++ b/pkg/gui/presentation/pull_requests.go
@@ -0,0 +1,361 @@
+package presentation
+
+import (
+	"fmt"
+	"html"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/gui/presentation/icons"
+	"github.com/jesseduffield/lazygit/pkg/gui/style"
+	"github.com/jesseduffield/lazygit/pkg/theme"
+	"github.com/samber/lo"
+)
+
+func GetPullRequestListDisplayStrings(prs []*models.GithubPullRequest) [][]string {
+	return lo.Map(prs, func(pr *models.GithubPullRequest, _ int) []string {
+		headBranch := pr.HeadRefName
+		if pr.HeadRepositoryOwner.Login != pr.Author {
+			headBranch = pr.HeadRepositoryOwner.Login + ":" + headBranch
+		}
+		color := prRowColor(pr)
+		icon := lo.Ternary(icons.IsIconEnabled(), icons.GITHUB_ICON, "#")
+		title := pr.Title + " (#" + pr.ID() + ")"
+		// Drafts are grayed out on the whole row
+		if pr.State == "DRAFT" {
+			return []string{color.Sprint(icon), color.Sprint(title), color.Sprint(pr.Author), color.Sprint(headBranch)}
+		}
+		return []string{
+			color.Sprint(icon),
+			theme.DefaultTextColor.Sprint(title),
+			style.FgCyan.Sprint(pr.Author),
+			style.FgYellow.Sprint(headBranch),
+		}
+	})
+}
+
+func prRowColor(pr *models.GithubPullRequest) style.TextStyle {
+	switch {
+	case pr.State == "DRAFT":
+		return style.FgBlackLighter
+	case pr.ChecksState == "FAILURE" || pr.ChecksState == "ERROR":
+		return style.FgRed
+	case pr.ReviewDecision == "APPROVED":
+		return style.FgGreen
+	case pr.AssignedToMe:
+		return style.FgYellow
+	default:
+		return theme.DefaultTextColor
+	}
+}
+
+func prStatusColor(status string) style.TextStyle {
+	switch status {
+	case "SUCCESS", "APPROVED":
+		return style.FgGreen
+	case "FAILURE", "ERROR", "CHANGES_REQUESTED", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED":
+		return style.FgRed
+	case "PENDING", "IN_PROGRESS", "QUEUED", "EXPECTED", "REVIEW_REQUIRED", "WAITING":
+		return style.FgYellow
+	default:
+		return style.FgDefault
+	}
+}
+
+func prStatusIcon(status string) string {
+	switch status {
+	case "SUCCESS", "APPROVED":
+		return "✅"
+	case "FAILURE", "ERROR", "CHANGES_REQUESTED", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED":
+		return "❌"
+	case "PENDING", "IN_PROGRESS", "QUEUED", "EXPECTED", "REVIEW_REQUIRED", "WAITING":
+		return "⏳"
+	default:
+		return ""
+	}
+}
+
+func mdStatus(status string) string {
+	icon := prStatusIcon(status)
+	if icon == "" {
+		return status
+	}
+	return icon + " " + status
+}
+
+func mdTableCell(s string) string {
+	s = strings.ReplaceAll(s, "|", "\\|")
+	return strings.ReplaceAll(s, "\n", " ")
+}
+
+var (
+	mdCodeSpan  = regexp.MustCompile("`[^`\n]+`")
+	htmlComment = regexp.MustCompile(`(?s)<!--.*?-->`)
+	htmlImgAlt  = regexp.MustCompile(`(?is)<img\b[^>]*?\balt\s*=\s*"([^"]*)"[^>]*>`)
+	htmlLink    = regexp.MustCompile(`(?is)<a\b[^>]*?\bhref\s*=\s*"([^"]*)"[^>]*>(.*?)</a>`)
+	htmlDetails = regexp.MustCompile(`(?i)<(/?)details\b[^>]*>`)
+	htmlSummary = regexp.MustCompile(`(?is)<summary\b[^>]*>(.*?)</summary>`)
+	// Tags leaf prints literally or drops with their content; leaf renders b, i, em, strong, code, del, ins, u and br itself
+	htmlUnsupported = regexp.MustCompile(`(?i)</?(?:p|div|span|dl|dt|dd|h[1-6]|sup|sub|kbd|center|picture|source|img|a|details|summary)\b[^>]*>`)
+)
+
+// PullRequestHTMLToMarkdown rewrites GitHub's HTML into markdown leaf can render.
+// <details> blocks collapse to their summary line, as the GitHub web UI shows them.
+func PullRequestHTMLToMarkdown(s string) string {
+	s = collapseDetails(s)
+	lines := strings.Split(s, "\n")
+	inFence := false
+	start := 0
+	var out []string
+	flush := func(end int) {
+		if end > start {
+			out = append(out, outsideCodeSpans(strings.Join(lines[start:end], "\n"), inlineHTMLToMarkdown))
+		}
+	}
+	for i, l := range lines {
+		if strings.HasPrefix(strings.TrimSpace(l), "```") {
+			if !inFence {
+				flush(i)
+				start = i
+			} else {
+				out = append(out, strings.Join(lines[start:i+1], "\n"))
+				start = i + 1
+			}
+			inFence = !inFence
+		}
+	}
+	if inFence {
+		out = append(out, strings.Join(lines[start:], "\n"))
+	} else {
+		flush(len(lines))
+	}
+	return strings.Join(out, "\n")
+}
+
+func outsideCodeSpans(s string, f func(string) string) string {
+	var b strings.Builder
+	last := 0
+	for _, m := range mdCodeSpan.FindAllStringIndex(s, -1) {
+		b.WriteString(f(s[last:m[0]]))
+		b.WriteString(s[m[0]:m[1]])
+		last = m[1]
+	}
+	b.WriteString(f(s[last:]))
+	return b.String()
+}
+
+func inlineHTMLToMarkdown(s string) string {
+	s = htmlComment.ReplaceAllString(s, "")
+	s = htmlImgAlt.ReplaceAllString(s, "$1")
+	s = htmlLink.ReplaceAllStringFunc(s, func(m string) string {
+		sub := htmlLink.FindStringSubmatch(m)
+		text := strings.Join(strings.Fields(htmlUnsupported.ReplaceAllString(sub[2], "")), " ")
+		if text == "" {
+			return ""
+		}
+		return "[" + text + "](" + html.UnescapeString(sub[1]) + ")"
+	})
+	return htmlUnsupported.ReplaceAllString(s, "")
+}
+
+// shortcut: a <details> tag inside a fenced code block is collapsed too, rare in PR comments.
+func collapseDetails(s string) string {
+	spans := mdCodeSpan.FindAllStringIndex(s, -1)
+	var b strings.Builder
+	depth, last, open := 0, 0, 0
+	for _, m := range htmlDetails.FindAllStringSubmatchIndex(s, -1) {
+		if lo.ContainsBy(spans, func(sp []int) bool { return sp[0] < m[0] && m[1] < sp[1] }) {
+			continue
+		}
+		if m[3] == m[2] {
+			if depth == 0 {
+				open = m[0]
+			}
+			depth++
+			continue
+		}
+		if depth == 0 {
+			continue
+		}
+		depth--
+		if depth > 0 {
+			continue
+		}
+		summary := "Details"
+		if sm := htmlSummary.FindStringSubmatch(s[open:m[1]]); sm != nil {
+			if text := strings.Join(strings.Fields(inlineHTMLToMarkdown(sm[1])), " "); text != "" {
+				summary = text
+			}
+		}
+		b.WriteString(s[last:open])
+		b.WriteString("\n\n**▶ " + summary + "**\n\n")
+		last = m[1]
+	}
+	b.WriteString(s[last:])
+	return b.String()
+}
+
+func FormatPullRequestDetailsMarkdown(d *models.GithubPullRequestDetails) string {
+	sections := []string{
+		fmt.Sprintf("# #%d %s", d.Number, d.Title),
+		fmt.Sprintf("**State:** %s · **Author:** @%s\n%s", d.State, d.Author, d.Url),
+	}
+
+	review := "NONE"
+	if d.ReviewDecision != "" {
+		review = mdStatus(d.ReviewDecision)
+	}
+	reviewSection := "## Review: " + review
+	if len(d.Reviewers) == 0 {
+		reviewSection += "\n\n_No reviewers_"
+	} else {
+		lines := []string{"| Reviewer | State |", "|---|---|"}
+		for _, r := range d.Reviewers {
+			lines = append(lines, fmt.Sprintf("| @%s | %s |", mdTableCell(r.Login), mdTableCell(mdStatus(r.State))))
+		}
+		reviewSection += "\n\n" + strings.Join(lines, "\n")
+	}
+	sections = append(sections, reviewSection)
+
+	checks := "NONE"
+	if d.ChecksState != "" {
+		checks = mdStatus(d.ChecksState)
+	}
+	checksSection := "## Checks: " + checks
+	if len(d.Checks) == 0 {
+		checksSection += "\n\n_No checks_"
+	} else {
+		lines := []string{"| Check | Status |", "|---|---|"}
+		for _, c := range d.Checks {
+			lines = append(lines, fmt.Sprintf("| %s | %s |", mdTableCell(c.Name), mdTableCell(mdStatus(c.Status))))
+		}
+		checksSection += "\n\n" + strings.Join(lines, "\n")
+	}
+	sections = append(sections, checksSection)
+
+	body := strings.ReplaceAll(d.Body, "\r\n", "\n")
+	description := "## Description"
+	if body == "" {
+		description += "\n\n_No description_"
+	} else {
+		description += "\n\n" + body
+	}
+	sections = append(sections, description)
+
+	comments := fmt.Sprintf("## Comments (%d)", len(d.Comments))
+	if len(d.Comments) == 0 {
+		comments += "\n\n_No comments_"
+	} else {
+		blocks := make([]string, 0, len(d.Comments))
+		for _, c := range d.Comments {
+			heading := fmt.Sprintf("### @%s · %s", c.Author, c.CreatedAt.Format("2006-01-02 15:04"))
+			if c.ReviewState != "" {
+				heading += " · " + mdStatus(c.ReviewState)
+			}
+			if c.Path != "" {
+				heading += " · `" + c.Path + "`"
+			}
+			if c.Resolved {
+				commentsCount := fmt.Sprintf("%d comments", c.ThreadSize)
+				if c.ThreadSize == 1 {
+					commentsCount = "1 comment"
+				}
+				blocks = append(blocks, heading+" · ✔ Resolved ("+commentsCount+")")
+			} else if c.Hidden != "" {
+				blocks = append(blocks, heading+" · Hidden: "+c.Hidden)
+			} else {
+				cBody := strings.ReplaceAll(c.Body, "\r\n", "\n")
+				if cBody == "" {
+					cBody = "_No text_"
+				}
+				blocks = append(blocks, heading+"\n\n"+cBody)
+			}
+		}
+		comments += "\n\n" + strings.Join(blocks, "\n\n---\n\n")
+	}
+	sections = append(sections, comments)
+
+	return strings.Join(sections, "\n\n")
+}
+
+func FormatPullRequestDetails(d *models.GithubPullRequestDetails) string {
+	lines := []string{
+		style.AttrBold.Sprint("#" + strconv.Itoa(d.Number) + " " + d.Title),
+		"State: " + WithPrColor(d.State, d.State, false) + "   " + style.FgCyan.Sprint("Author: "+d.Author),
+		"URL: " + d.Url,
+		"",
+	}
+
+	review := "NONE"
+	if d.ReviewDecision != "" {
+		review = prStatusColor(d.ReviewDecision).Sprint(d.ReviewDecision)
+	}
+	lines = append(lines, "Review: "+review, "Reviewers:")
+	if len(d.Reviewers) == 0 {
+		lines = append(lines, "  none")
+	} else {
+		for _, r := range d.Reviewers {
+			lines = append(lines, "  "+r.Login+"  "+prStatusColor(r.State).Sprint(r.State))
+		}
+	}
+	lines = append(lines, "")
+
+	checks := "NONE"
+	if d.ChecksState != "" {
+		checks = prStatusColor(d.ChecksState).Sprint(d.ChecksState)
+	}
+	lines = append(lines, "Checks: "+checks)
+	for _, c := range d.Checks {
+		lines = append(lines, "  "+c.Name+"  "+prStatusColor(c.Status).Sprint(c.Status))
+	}
+	lines = append(lines, "")
+
+	lines = append(lines, "Description:")
+	body := strings.ReplaceAll(d.Body, "\r\n", "\n")
+	if body == "" {
+		lines = append(lines, "  (no description)")
+	} else {
+		for _, l := range strings.Split(body, "\n") {
+			lines = append(lines, "  "+l)
+		}
+	}
+	lines = append(lines, "")
+
+	lines = append(lines, fmt.Sprintf("Comments (%d):", len(d.Comments)))
+	if len(d.Comments) == 0 {
+		lines = append(lines, "  none")
+	} else {
+		for i, c := range d.Comments {
+			header := "  " + style.FgCyan.Sprint(c.Author) + " · " + c.CreatedAt.Format("2006-01-02 15:04")
+			if c.ReviewState != "" {
+				header += " · " + prStatusColor(c.ReviewState).Sprint(c.ReviewState)
+			}
+			if c.Path != "" {
+				header += " · " + style.FgYellow.Sprint(c.Path)
+			}
+			if c.Resolved {
+				commentsCount := fmt.Sprintf("%d comments", c.ThreadSize)
+				if c.ThreadSize == 1 {
+					commentsCount = "1 comment"
+				}
+				lines = append(lines, header+" · "+style.FgGreen.Sprint("Resolved ("+commentsCount+")"))
+			} else if c.Hidden != "" {
+				lines = append(lines, header+" · "+style.FgBlackLighter.Sprint("Hidden: "+c.Hidden))
+			} else {
+				lines = append(lines, header)
+				cBody := strings.ReplaceAll(c.Body, "\r\n", "\n")
+				if cBody != "" {
+					for _, l := range strings.Split(cBody, "\n") {
+						lines = append(lines, "    "+l)
+					}
+				}
+			}
+			if i < len(d.Comments)-1 {
+				lines = append(lines, "")
+			}
+		}
+	}
+	return strings.Join(lines, "\n")
+}
