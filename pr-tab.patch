+func parsePullRequestDetails(body []byte) (*models.GithubPullRequestDetails, error) {
+	var result PullRequestDetailsResponse
+	if err := json.Unmarshal(body, &result); err != nil {
+		return nil, err
+	}
+
+	if len(result.Errors) > 0 {
+		messages := make([]string, len(result.Errors))
+		for i, e := range result.Errors {
+			messages[i] = e.Message
+		}
+		return nil, fmt.Errorf("GitHub GraphQL error: %s", strings.Join(messages, "; "))
+	}
+
+	pr := result.Data.Repository.PullRequest
+	if pr == nil {
+		return nil, errors.New("pull request not found")
+	}
+
+	state := pr.State
+	if pr.IsDraft && state == "OPEN" {
+		state = "DRAFT"
+	}
+
+	reviewers := []models.GithubReviewer{}
+	for _, node := range pr.LatestOpinionatedReviews.Nodes {
+		reviewers = append(reviewers, models.GithubReviewer{
+			Login: authorLogin(node.Author),
+			State: node.State,
+		})
+	}
+	for _, node := range pr.ReviewRequests.Nodes {
+		if node.RequestedReviewer == nil {
+			continue
+		}
+		login := node.RequestedReviewer.Login
+		if node.RequestedReviewer.Typename == "Team" {
+			login = node.RequestedReviewer.Name
+		}
+		found := false
+		for i := range reviewers {
+			if reviewers[i].Login == login {
+				reviewers[i].State = "PENDING"
+				found = true
+				break
+			}
+		}
+		if !found {
+			reviewers = append(reviewers, models.GithubReviewer{Login: login, State: "PENDING"})
+		}
+	}
+
+	checksState := ""
+	checks := []models.GithubCheck{}
+	if len(pr.Commits.Nodes) > 0 && pr.Commits.Nodes[0].Commit != nil && pr.Commits.Nodes[0].Commit.StatusCheckRollup != nil {
+		rollup := pr.Commits.Nodes[0].Commit.StatusCheckRollup
+		checksState = rollup.State
+		for _, node := range rollup.Contexts.Nodes {
+			switch node.Typename {
+			case "CheckRun":
+				status := node.Status
+				if node.Status == "COMPLETED" {
+					status = node.Conclusion
+				}
+				checks = append(checks, models.GithubCheck{Name: node.Name, Status: status})
+			case "StatusContext":
+				checks = append(checks, models.GithubCheck{Name: node.Context, Status: node.State})
+			}
+		}
+	}
+
+	// Build resolved-thread map: inline comment id -> (threadFirstId, threadSize)
+	resolvedThreadMap := map[string]struct {
+		firstID string
+		size    int
+	}{}
+	for _, rt := range pr.ReviewThreads.Nodes {
+		if !rt.IsResolved || len(rt.Comments.Nodes) == 0 {
+			continue
+		}
+		firstID := rt.Comments.Nodes[0].ID
+		for _, c := range rt.Comments.Nodes {
+			resolvedThreadMap[c.ID] = struct {
+				firstID string
+				size    int
+			}{firstID: firstID, size: len(rt.Comments.Nodes)}
+		}
+	}
+
+	comments := []models.GithubComment{}
+	for _, item := range pr.TimelineItems.Nodes {
+		switch item.Typename {
+		case "IssueComment":
+			c := models.GithubComment{
+				Author:    authorLogin(item.Author),
+				Body:      item.Body,
+				CreatedAt: parseCreatedAt(item.CreatedAt),
+			}
+			c.Hidden = hiddenReason(item.IsMinimized, item.MinimizedReason)
+			comments = append(comments, c)
+		case "PullRequestReview":
+			if item.Body != "" || item.State != "COMMENTED" {
+				c := models.GithubComment{
+					Author:      authorLogin(item.Author),
+					Body:        item.Body,
+					ReviewState: item.State,
+					CreatedAt:   parseCreatedAt(item.CreatedAt),
+				}
+				c.Hidden = hiddenReason(item.IsMinimized, item.MinimizedReason)
+				comments = append(comments, c)
+			}
+			for _, c := range item.Comments.Nodes {
+				if tid, ok := resolvedThreadMap[c.ID]; ok {
+					if c.ID == tid.firstID {
+						comments = append(comments, models.GithubComment{
+							Author:     authorLogin(c.Author),
+							Body:       c.Body,
+							Path:       c.Path,
+							CreatedAt:  parseCreatedAt(c.CreatedAt),
+							Resolved:   true,
+							ThreadSize: tid.size,
+							Hidden:     hiddenReason(c.IsMinimized, c.MinimizedReason),
+						})
+					}
+					// skip non-first comments in resolved threads
+				} else {
+					comments = append(comments, models.GithubComment{
+						Author:    authorLogin(c.Author),
+						Body:      c.Body,
+						Path:      c.Path,
+						CreatedAt: parseCreatedAt(c.CreatedAt),
+						Hidden:    hiddenReason(c.IsMinimized, c.MinimizedReason),
+					})
+				}
+			}
+		}
+	}
+
+	return &models.GithubPullRequestDetails{
+		NodeID:         pr.ID,
+		Number:         pr.Number,
+		Title:          pr.Title,
+		Body:           pr.Body,
+		Url:            pr.Url,
+		Author:         authorLogin(pr.Author),
+		State:          state,
+		ReviewDecision: pr.ReviewDecision,
+		Reviewers:      reviewers,
+		ChecksState:    checksState,
+		Checks:         checks,
+		Comments:       comments,
+	}, nil
+}
+
+// FetchPullRequestDetails fetches the details of a single pull request using GraphQL.
+func (self *GitHubCommands) FetchPullRequestDetails(repo *hosting_service.ServiceInfo, number int, token string) (*models.GithubPullRequestDetails, error) {
+	body, err := self.postGraphQL(repo.WebDomain, pullRequestDetailsQuery(number), map[string]string{"owner": repo.Owner, "repo": repo.Repository}, token)
+	if err != nil {
+		return nil, err
+	}
+
+	return parsePullRequestDetails(body)
+}
+
+// restEndpoint returns the REST API base URL for a GitHub host.
+func restEndpoint(host string) string {
+	if auth.NormalizeHostname(host) == "github.com" {
+		return "https://api.github.com"
+	}
+	return "https://" + host + "/api/v3"
+}
+
+func (self *GitHubCommands) FetchPullRequestCmdObj(task gocui.Task, remoteName string, number int, branchName string) *oscommands.CmdObj {
+	cmdArgs := NewGitCmd("fetch").
+		Arg(remoteName).
+		Arg(fmt.Sprintf("pull/%d/head:%s", number, branchName)).
+		ToArgv()
+
+	cmdObj := self.cmd.New(cmdArgs)
+	cmdObj.PromptOnCredentialRequest(task)
+	return cmdObj
+}
+
+func (self *GitHubCommands) FetchPullRequestRefCmdObj(task gocui.Task, remoteName string, number int) *oscommands.CmdObj {
+	cmdArgs := NewGitCmd("fetch").
+		Arg(remoteName).
+		Arg(fmt.Sprintf("+pull/%d/head:%s", number, (&models.GithubPullRequestRef{Number: number}).FullRefName())).
+		ToArgv()
+
+	cmdObj := self.cmd.New(cmdArgs)
+	cmdObj.PromptOnCredentialRequest(task)
+	return cmdObj
+}
+
+// Fork PRs often use branch names like "master" that would clash with local
+// branches, so prefix with the head repo owner in that case.
+func PullRequestLocalBranchName(pr *models.GithubPullRequest, baseOwner string) string {
+	if strings.EqualFold(pr.HeadRepositoryOwner.Login, baseOwner) {
+		return pr.HeadRefName
+	}
+	return pr.HeadRepositoryOwner.Login + "/" + pr.HeadRefName
+}
