+type graphQLError struct {
+	Message string `json:"message"`
+	Type    string `json:"type"`
+}
+
+// repoNotFoundError returns a wrapped ErrGithubRepoNotFound if the GraphQL
+// response reports the repository could not be resolved.
+func repoNotFoundError(errs []graphQLError) error {
+	for _, e := range errs {
+		if e.Type == "NOT_FOUND" {
+			return fmt.Errorf("%w: %s", ErrGithubRepoNotFound, e.Message)
+		}
+	}
+	return nil
+}
