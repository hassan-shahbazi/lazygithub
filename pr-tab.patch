+package context
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/gui/presentation"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+)
+
+const PULL_REQUESTS_CONTEXT_KEY types.ContextKey = "pullRequests"
+
+func init() {
+	AllContextKeys = append(AllContextKeys, PULL_REQUESTS_CONTEXT_KEY)
+}
+
+type PullRequestsContext struct {
+	*FilteredListViewModel[*models.GithubPullRequest]
+	*ListContextTrait
+}
+
+var _ types.IListContext = (*PullRequestsContext)(nil)
+
+func NewPullRequestsContext(
+	c *ContextCommon,
+) *PullRequestsContext {
+	viewModel := NewFilteredListViewModel(
+		func() []*models.GithubPullRequest { return c.Model().OpenPullRequests },
+		func(pr *models.GithubPullRequest) []string {
+			return []string{"#" + pr.ID(), pr.Title, pr.HeadRefName, pr.Author}
+		},
+	)
+
+	getDisplayStrings := func(_ int, _ int) [][]string {
+		return presentation.GetPullRequestListDisplayStrings(viewModel.GetItems())
+	}
+
+	return &PullRequestsContext{
+		FilteredListViewModel: viewModel,
+		ListContextTrait: &ListContextTrait{
+			Context: NewSimpleContext(NewBaseContext(NewBaseContextOpts{
+				View:       c.Views().PullRequests,
+				WindowName: "branches",
+				Key:        PULL_REQUESTS_CONTEXT_KEY,
+				Kind:       types.SIDE_CONTEXT,
+				Focusable:  true,
+			})),
+			ListRenderer: ListRenderer{
+				list:              viewModel,
+				getDisplayStrings: getDisplayStrings,
+			},
+			c: c,
+		},
+	}
+}
+
+func (self *PullRequestsContext) HandleRender() {
+	if !self.c.UserConfig().Git.PullRequests.Enabled && self.list.Len() == 0 {
+		self.GetViewTrait().SetContent(self.c.Tr.PullRequestsDisabled)
+		self.c.Render()
+		return
+	}
+	self.ListContextTrait.HandleRender()
+}
