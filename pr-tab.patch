+// FetchOpenPullRequests fetches the repo's pull requests matching the GitHub search filter.
+func (self *GitHubCommands) FetchOpenPullRequests(repo *hosting_service.ServiceInfo, filter string, token string) ([]*models.GithubPullRequest, error) {
+	q := buildOpenPullRequestsSearch(repo.Owner, repo.Repository, filter)
+	body, err := self.postGraphQL(repo.WebDomain, openPullRequestsQuery, map[string]string{"q": q}, token)
+	if err != nil {
+		return nil, err
+	}
+
+	return parseOpenPullRequests(body)
+}
+
+// AddPullRequestComment adds a comment to a pull request.
+func (self *GitHubCommands) AddPullRequestComment(repo *hosting_service.ServiceInfo, nodeID string, body string, token string) error {
+	resp, err := self.postGraphQL(repo.WebDomain, addCommentMutation, map[string]string{"subjectId": nodeID, "body": body}, token)
+	if err != nil {
+		return err
+	}
+	return parseMutationResponse(resp)
+}
+
+// SubmitPullRequestReview submits a review for a pull request. event is "APPROVE" or "REQUEST_CHANGES".
+func (self *GitHubCommands) SubmitPullRequestReview(repo *hosting_service.ServiceInfo, nodeID string, event string, body string, token string) error {
+	resp, err := self.postGraphQL(repo.WebDomain, addReviewMutation, map[string]string{"pullRequestId": nodeID, "event": event, "body": body}, token)
+	if err != nil {
+		return err
+	}
+	return parseMutationResponse(resp)
+}
+
+// FetchMergeMethods fetches the merge methods allowed for the repository.
+func (self *GitHubCommands) FetchMergeMethods(repo *hosting_service.ServiceInfo, token string) ([]string, error) {
+	body, err := self.postGraphQL(repo.WebDomain, mergeMethodsQuery, map[string]string{"owner": repo.Owner, "repo": repo.Repository}, token)
+	if err != nil {
+		return nil, err
+	}
+
+	return parseMergeMethods(body)
+}
+
+// MergePullRequest merges a pull request using the given method.
+func (self *GitHubCommands) MergePullRequest(repo *hosting_service.ServiceInfo, nodeID string, method string, token string) error {
+	resp, err := self.postGraphQL(repo.WebDomain, mergePullRequestMutation, map[string]string{"pullRequestId": nodeID, "mergeMethod": method}, token)
+	if err != nil {
+		return err
+	}
+	return parseMutationResponse(resp)
+}
