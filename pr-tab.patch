+// FetchOpenPullRequests fetches the repo's pull requests matching the GitHub search filter.
+func (self *GitHubCommands) FetchOpenPullRequests(baseRemote *models.Remote, filter string, token string) ([]*models.GithubPullRequest, error) {
+	repoOwner, repoName, err := self.GetBaseRepoOwnerAndName(baseRemote)
+	if err != nil {
+		return nil, err
+	}
+
+	q := buildOpenPullRequestsSearch(repoOwner, repoName, filter)
+	body, err := self.postGraphQL(openPullRequestsQuery, map[string]string{"q": q}, token)
+	if err != nil {
+		return nil, err
+	}
+
+	return parseOpenPullRequests(body)
+}
