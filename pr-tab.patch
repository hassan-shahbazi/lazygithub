diff --git a/pkg/gui/controllers/helpers/refresh_helper_pull_requests.go b/pkg/gui/controllers/helpers/refresh_helper_pull_requests.go
new file mode 100644
index 000000000..19641fe9c
--- /dev/null
+++ b/pkg/gui/controllers/helpers/refresh_helper_pull_requests.go
@@ -0,0 +1,206 @@
+package helpers
+
+import (
+	stderrors "errors"
+	"fmt"
+
+	"github.com/go-errors/errors"
+	"github.com/jesseduffield/lazygit/pkg/commands"
+	"github.com/jesseduffield/lazygit/pkg/commands/git_commands"
+	"github.com/jesseduffield/lazygit/pkg/commands/hosting_service"
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/sasha-s/go-deadlock"
+)
+
+// Per repo path: whether the pull requests tab list was fetched, and the last
+// fetch error. Written from workers, read on the UI thread.
+type openPullRequestsState struct {
+	openPullRequestsMutex  deadlock.Mutex
+	openPullRequestsLoaded map[string]bool
+	openPullRequestsError  map[string]string
+}
+
+func (self *RefreshHelper) refreshOpenPullRequestsIfNotLoaded(baseInfo *githubRemoteInfo, env refreshEnv) {
+	if !self.c.UserConfig().Git.PullRequests.Enabled {
+		self.onUIThreadUnlessRepoChanged(env, self.clearOpenPullRequests)
+		return
+	}
+
+	repoPath := env.git.RepoPaths.RepoPath()
+	self.openPullRequestsMutex.Lock()
+	loaded := self.openPullRequestsLoaded[repoPath]
+	self.openPullRequestsMutex.Unlock()
+	if loaded {
+		return
+	}
+
+	prs, err := self.fetchOpenPullRequests(baseInfo, env.git)
+	if err != nil {
+		self.c.LogAction(fmt.Sprintf("Error fetching open pull requests from GitHub: %s", err.Error()))
+	}
+	self.recordOpenPullRequestsResult(repoPath, err)
+	if err == nil {
+		self.onUIThreadUnlessRepoChanged(env, func() { self.setOpenPullRequests(prs) })
+	}
+}
+
+// fetchOpenPullRequests treats a repo the account can't see as having no pull
+// requests, so the tab shows its empty state instead of an error.
+func (self *RefreshHelper) fetchOpenPullRequests(baseInfo *githubRemoteInfo, git *commands.GitCommand) ([]*models.GithubPullRequest, error) {
+	prs, err := git.GitHub.FetchOpenPullRequests(&baseInfo.serviceInfo, self.c.UserConfig().Git.PullRequests.Filter, baseInfo.authToken)
+	if stderrors.Is(err, git_commands.ErrGithubRepoNotFound) {
+		return nil, nil
+	}
+	return prs, err
+}
+
+func (self *RefreshHelper) setOpenPullRequests(prs []*models.GithubPullRequest) {
+	self.c.Model().OpenPullRequests = prs
+	self.c.PostRefreshUpdate(self.c.Contexts().PullRequests)
+}
+
+func (self *RefreshHelper) clearOpenPullRequests() {
+	self.setOpenPullRequests(nil)
+}
+
+func (self *RefreshHelper) recordOpenPullRequestsResult(repoPath string, err error) {
+	self.openPullRequestsMutex.Lock()
+	defer self.openPullRequestsMutex.Unlock()
+	if self.openPullRequestsLoaded == nil {
+		self.openPullRequestsLoaded = map[string]bool{}
+		self.openPullRequestsError = map[string]string{}
+	}
+	if err != nil {
+		self.openPullRequestsError[repoPath] = err.Error()
+	} else {
+		delete(self.openPullRequestsError, repoPath)
+	}
+	self.openPullRequestsLoaded[repoPath] = true
+}
+
+func (self *RefreshHelper) OpenPullRequestsFailed() bool {
+	self.openPullRequestsMutex.Lock()
+	defer self.openPullRequestsMutex.Unlock()
+	_, exists := self.openPullRequestsError[self.c.Git().RepoPaths.RepoPath()]
+	return exists
+}
+
+// githubBase returns the authenticated base GitHub remote of the current repo,
+// or nil without an error when the repo has no GitHub remote at all.
+func (self *RefreshHelper) githubBase() (*githubRemoteInfo, error) {
+	githubRemotes := self.getGithubRemotes(self.c.Model().Remotes, refreshEnv{git: self.c.Git()})
+	if len(githubRemotes) == 0 {
+		return nil, nil
+	}
+	githubRemotes = getAuthenticatedGithubRemotes(githubRemotes, self.c.Git().GitHub.GetAuthToken)
+	if len(githubRemotes) == 0 {
+		return nil, errors.New(self.c.Tr.NoGithubToken)
+	}
+	baseInfo := getGithubBaseRemote(githubRemotes, self.c.Git().GitHub.ConfiguredBaseRemoteName())
+	if baseInfo == nil {
+		return nil, errors.New(self.c.Tr.NoGithubBaseRemote)
+	}
+	return baseInfo, nil
+}
+
+func (self *RefreshHelper) requireGithubBase() (*githubRemoteInfo, error) {
+	baseInfo, err := self.githubBase()
+	if err == nil && baseInfo == nil {
+		err = errors.New(self.c.Tr.NoGithubBaseRemote)
+	}
+	return baseInfo, err
+}
+
+// RefreshOpenPullRequests runs on a worker.
+func (self *RefreshHelper) RefreshOpenPullRequests() error {
+	if !self.c.UserConfig().Git.PullRequests.Enabled {
+		self.c.OnUIThread(func() error { self.clearOpenPullRequests(); return nil })
+		return nil
+	}
+
+	baseInfo, err := self.githubBase()
+	if err != nil {
+		return err
+	}
+	if baseInfo == nil {
+		self.c.OnUIThread(func() error { self.clearOpenPullRequests(); return nil })
+		return nil
+	}
+
+	git := self.c.Git()
+	prs, err := self.fetchOpenPullRequests(baseInfo, git)
+	self.recordOpenPullRequestsResult(git.RepoPaths.RepoPath(), err)
+	if err != nil {
+		return err
+	}
+	self.c.OnUIThread(func() error {
+		if self.c.Git() == git {
+			self.setOpenPullRequests(prs)
+		}
+		return nil
+	})
+	return nil
+}
+
+// GithubBase returns the base GitHub remote and the repo it points at.
+func (self *RefreshHelper) GithubBase() (*models.Remote, *hosting_service.ServiceInfo, error) {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return nil, nil, err
+	}
+	return baseInfo.remote, &baseInfo.serviceInfo, nil
+}
+
+func (self *RefreshHelper) FetchPullRequestDetails(number int) (*models.GithubPullRequestDetails, error) {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return nil, err
+	}
+	return self.c.Git().GitHub.FetchPullRequestDetails(&baseInfo.serviceInfo, number, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) AddPullRequestComment(nodeID string, body string) error {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return err
+	}
+	return self.c.Git().GitHub.AddPullRequestComment(&baseInfo.serviceInfo, nodeID, body, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) AddPullRequestLineComment(number int, c git_commands.PullRequestLineComment) error {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return err
+	}
+	return self.c.Git().GitHub.AddPullRequestLineComment(&baseInfo.serviceInfo, number, c, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) FetchPullRequestMergeMethods() ([]string, error) {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return nil, err
+	}
+	return self.c.Git().GitHub.FetchMergeMethods(&baseInfo.serviceInfo, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) MergePullRequest(nodeID string, method string) error {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return err
+	}
+	return self.c.Git().GitHub.MergePullRequest(&baseInfo.serviceInfo, nodeID, method, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) SubmitPullRequestReview(nodeID string, event string, body string) error {
+	baseInfo, err := self.requireGithubBase()
+	if err != nil {
+		return err
+	}
+	return self.c.Git().GitHub.SubmitPullRequestReview(&baseInfo.serviceInfo, nodeID, event, body, baseInfo.authToken)
+}
+
+func (self *RefreshHelper) resetOpenPullRequestsLoaded() {
+	self.openPullRequestsMutex.Lock()
+	defer self.openPullRequestsMutex.Unlock()
+	delete(self.openPullRequestsLoaded, self.c.Git().RepoPaths.RepoPath())
+}
