--- a/pkg/gui/side_panels.go
+++ b/pkg/gui/side_panels.go
@@ -37,6 +37,8 @@ func (gui *Gui) sidePanelTabTitles() map[string]string {
 		"commits":    tr.CommitsTitle,
 		"reflog":     tr.ReflogCommitsTitle,
