diff --git a/pkg/gui/controllers/pull_request_line_comment.go b/pkg/gui/controllers/pull_request_line_comment.go
new file mode 100644
index 000000000..570cddf08
--- /dev/null
+++ b/pkg/gui/controllers/pull_request_line_comment.go
@@ -0,0 +1,146 @@
+package controllers
+
+import (
+	"errors"
+
+	"github.com/jesseduffield/lazygit/pkg/commands/git_commands"
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/gocui"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+	"github.com/samber/lo"
+)
+
+// lineCommentRange maps the diff rows of a selection to the GitHub line comment
+// parameters. GitHub places comments by their line in the new version of the file,
+// so deleted rows are skipped, and the rest must be added or unchanged lines of one file.
+func lineCommentRange(infos []types.DiffLineInfo) (path string, startLine int, line int, ok bool) {
+	infos = lo.Filter(infos, func(info types.DiffLineInfo, _ int) bool { return info.Type != types.DiffLineDeleted })
+	if len(infos) == 0 {
+		return "", 0, 0, false
+	}
+	for _, info := range infos {
+		if (info.Type != types.DiffLineAdded && info.Type != types.DiffLineContext) || info.Path != infos[0].Path {
+			return "", 0, 0, false
+		}
+	}
+	first, last := infos[0].NewLine, infos[len(infos)-1].NewLine
+	if first < last {
+		startLine = first
+	}
+	return infos[0].Path, startLine, last, true
+}
+
+// pullRequestCommitForLineComment returns the pull request opened from the pull
+// requests tab and the single commit whose diff the focused main view shows.
+func (self *MainViewController) pullRequestCommitForLineComment() (*models.GithubPullRequestRef, models.Ref) {
+	subCommits := self.c.Contexts().SubCommits
+	pr, ok := subCommits.GetRef().(*models.GithubPullRequestRef)
+	if !ok {
+		return nil, nil
+	}
+	switch self.sidePanelBeneath() {
+	case subCommits:
+		if subCommits.GetSelectedRefRangeForDiffFiles() == nil {
+			return pr, subCommits.GetSelectedRef()
+		}
+	case self.c.Contexts().CommitFiles:
+		commitFiles := self.c.Contexts().CommitFiles
+		if commitFiles.GetParentContext() == subCommits && commitFiles.GetRefRange() == nil {
+			return pr, commitFiles.GetRef()
+		}
+	}
+	return nil, nil
+}
+
+func (self *MainViewController) inPullRequestDiff() bool {
+	pr, _ := self.pullRequestCommitForLineComment()
+	return pr != nil
+}
+
+// lineCommentSend captures the selected lines and returns the closure that sends the
+// comment on them.
+func (self *MainViewController) lineCommentSend() (func(string) error, error) {
+	pr, commit := self.pullRequestCommitForLineComment()
+	if pr == nil || commit == nil {
+		return nil, errors.New(self.c.Tr.PRLineCommentOnlyInPRTab)
+	}
+	view := self.context.GetView()
+	if !view.Highlight || self.c.Modes().Diffing.Active() || self.c.Helpers().DiffLine.ShowsCustomPatch(view) {
+		return nil, errors.New(self.c.Tr.PRLineCommentOnlyInPRTab)
+	}
+
+	first, last := view.SelectedLineRange()
+	infos := make([]types.DiffLineInfo, 0, last-first+1)
+	for i := first; i <= last; i++ {
+		info, ok := self.c.Helpers().DiffLine.GetDiffLineInfo(view, i)
+		if !ok {
+			return nil, errors.New(self.c.Tr.PRLineCommentDeletedLines)
+		}
+		infos = append(infos, info)
+	}
+	absPath, startLine, line, ok := lineCommentRange(infos)
+	if !ok {
+		return nil, errors.New(self.c.Tr.PRLineCommentDeletedLines)
+	}
+	path := repoRelativePath(self.c.Git().RepoPaths.WorktreePath(), absPath)
+	if path == "" {
+		return nil, diffLinesFileNotFoundError(self.c, absPath)
+	}
+	commitID := commit.RefName()
+
+	return func(text string) error {
+		return self.c.WithWaitingStatus(self.c.Tr.SendingPullRequestComment, func(gocui.Task) error {
+			if err := self.c.Helpers().Refresh.AddPullRequestLineComment(pr.Number, git_commands.PullRequestLineComment{
+				CommitID:  commitID,
+				Path:      path,
+				Body:      text,
+				Line:      line,
+				StartLine: startLine,
+			}); err != nil {
+				return err
+			}
+			self.c.Toast(self.c.Tr.PullRequestCommentSent)
+			return nil
+		})
+	}, nil
+}
+
+func (self *MainViewController) commentOnLines() error {
+	send, err := self.lineCommentSend()
+	if err != nil {
+		return err
+	}
+	return openCommentPanel(self.c, self.c.Tr.AddPullRequestLineComment, send)
+}
+
+func (self *MainViewController) commentOnLinesInEditor() error {
+	send, err := self.lineCommentSend()
+	if err != nil {
+		return err
+	}
+	path, err := newCommentFile(self.c)
+	if err != nil {
+		return err
+	}
+	return commentInEditor(self.c, path, send)
+}
+
+// orLineComment makes a working tree key comment on the selected lines instead while
+// the main view shows a commit of a pull request opened from the pull requests tab.
+func (self *MainViewController) orLineComment(workingTree func() error, comment func() error) func() error {
+	return func() error {
+		if self.inPullRequestDiff() {
+			return comment()
+		}
+		return self.workingTreeAction(workingTree)()
+	}
+}
+
+func (self *MainViewController) orLineCommentDescription(workingTree string, comment string) func() string {
+	return func() string {
+		if self.inPullRequestDiff() {
+			return comment
+		}
+		return self.workingTreeActionDescription(workingTree)()
+	}
+}
diff --git a/pkg/gui/controllers/pull_requests_controller.go b/pkg/gui/controllers/pull_requests_controller.go
new file mode 100644
index 000000000..b584de938
--- /dev/null
+++ b/pkg/gui/controllers/pull_requests_controller.go
@@ -0,0 +1,541 @@
+package controllers
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/go-errors/errors"
+	"github.com/jesseduffield/lazygit/pkg/commands/git_commands"
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/gocui"
+	"github.com/jesseduffield/lazygit/pkg/gui/context"
+	"github.com/jesseduffield/lazygit/pkg/gui/controllers/helpers"
+	"github.com/jesseduffield/lazygit/pkg/gui/presentation"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+	"github.com/samber/lo"
+)
+
+type PullRequestsController struct {
+	baseController
+	*ListControllerTrait[*models.GithubPullRequest]
+	c               *ControllerCommon
+	loadingDetails  map[int]bool
+	renderedDetails map[int]string
+}
+
+var _ types.IController = &PullRequestsController{}
+
+func NewPullRequestsController(
+	c *ControllerCommon,
+) *PullRequestsController {
+	return &PullRequestsController{
+		baseController: baseController{},
+		ListControllerTrait: NewListControllerTrait(
+			c,
+			c.Contexts().PullRequests,
+			c.Contexts().PullRequests.GetSelected,
+			c.Contexts().PullRequests.GetSelectedItems,
+		),
+		c:               c,
+		loadingDetails:  map[int]bool{},
+		renderedDetails: map[int]string{},
+	}
+}
+
+func (self *PullRequestsController) GetKeybindings(opts types.KeybindingsOpts) []*types.Binding {
+	bindings := []*types.Binding{
+		{
+			Keys: opts.GetKeys(opts.Config.Branches.FastForward),
+			Handler: func() error {
+				self.c.WithWaitingStatus(self.c.Tr.FetchingPullRequests, func(gocui.Task) error {
+					return self.c.Helpers().Refresh.RefreshOpenPullRequests()
+				})
+				return nil
+			},
+			Description:     self.c.Tr.RefreshPullRequests,
+			DisplayOnScreen: true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Universal.Select),
+			Handler:           self.withItem(self.checkout),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.CheckoutPullRequest,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Universal.GoInto),
+			Handler:           self.withItem(self.viewCommits),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.ViewCommits,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Branches.OpenPullRequestInBrowser),
+			Handler:           self.withItem(self.openInBrowser),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.OpenPullRequestInBrowser,
+			DisplayOnScreen:   false,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Universal.Edit),
+			Handler:           self.withItem(self.openInEditor),
+			GetDisabledReason: self.require(self.singleItemSelected(self.detailsLoaded)),
+			Description:       self.c.Tr.OpenPullRequestInEditor,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Universal.Pull),
+			Handler:           self.withItem(self.refreshDetails),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.RefreshPullRequest,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Files.CommitChanges),
+			Handler:           self.withItem(self.addComment),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.AddPullRequestComment,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Files.CommitChangesWithEditor),
+			Handler:           self.withItem(self.addCommentInEditor),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.AddPullRequestCommentInEditor,
+			DisplayOnScreen:   false,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Files.ToggleStagedAll),
+			Handler:           self.withItem(self.review),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.ReviewPullRequest,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Universal.CreateRebaseOptionsMenu),
+			Handler:           self.withItem(self.merge),
+			GetDisabledReason: self.require(self.singleItemSelected(self.canMerge)),
+			Description:       self.c.Tr.MergePullRequest,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Branches.CreatePullRequest),
+			Handler:           self.withItem(self.confirmOpenInBrowser),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.OpenPullRequestInBrowser,
+			DisplayOnScreen:   true,
+		},
+		{
+			Keys:              opts.GetKeys(opts.Config.Branches.CopyPullRequestURL),
+			Handler:           self.withItem(self.copyURL),
+			GetDisabledReason: self.require(self.singleItemSelected()),
+			Description:       self.c.Tr.CopyPullRequestURL,
+			DisplayOnScreen:   true,
+		},
+	}
+
+	return bindings
+}
+
+func (self *PullRequestsController) GetOnRenderToMain() func() {
+	return func() {
+		var task types.UpdateTask
+		pr := self.context().GetSelected()
+		if pr == nil {
+			task = types.NewRenderStringTask(self.c.Tr.NoPullRequests)
+		} else {
+			if r := self.renderedDetails[pr.Number]; r != "" {
+				task = types.NewRenderStringTask(r)
+			} else if d := self.c.Model().PullRequestDetails[pr.Number]; d != nil {
+				task = types.NewRenderStringTask(presentation.FormatPullRequestDetails(d))
+			} else {
+				text := strings.Join([]string{
+					fmt.Sprintf("#%d %s", pr.Number, pr.Title),
+					"",
+					fmt.Sprintf("State: %s", pr.State),
+					fmt.Sprintf("Author: %s", pr.Author),
+					fmt.Sprintf("Branch: %s:%s", pr.HeadRepositoryOwner.Login, pr.HeadRefName),
+					fmt.Sprintf("URL: %s", pr.Url),
+				}, "\n")
+				text += "\n\n" + self.c.Tr.LoadingPullRequestDetails
+				task = types.NewRenderStringTask(text)
+				self.loadDetails(pr.Number)
+			}
+		}
+
+		self.c.RenderToMainViews(types.RefreshMainOpts{
+			Pair: self.c.MainViewPairs().Normal,
+			Main: &types.ViewUpdateOpts{
+				Title: self.c.Tr.PullRequestTitle,
+				Task:  task,
+			},
+		})
+	}
+}
+
+func (self *PullRequestsController) GetOnFocus() func(types.OnFocusOpts) {
+	return func(opts types.OnFocusOpts) {
+		if !self.c.UserConfig().Git.PullRequests.Enabled {
+			return
+		}
+		if !self.c.Helpers().Refresh.OpenPullRequestsFailed() {
+			return
+		}
+		self.c.OnWorker(func(gocui.Task) error {
+			err := self.c.Helpers().Refresh.RefreshOpenPullRequests()
+			if err != nil {
+				self.c.LogAction(fmt.Sprintf("Error fetching open pull requests from GitHub: %s", err.Error()))
+			}
+			return nil
+		})
+	}
+}
+
+func (self *PullRequestsController) renderDetails(d *models.GithubPullRequestDetails, width int) string {
+	if _, err := exec.LookPath("leaf"); err != nil {
+		return ""
+	}
+	args := []string{"leaf", "--inline", "ansi:" + strconv.Itoa(max(width, 40))}
+	if theme := self.c.UserConfig().Git.PullRequests.Style; theme != "" {
+		args = append(args, "--theme", theme)
+	}
+	out, err := self.c.OS().Cmd.New(args).SetStdin(presentation.PullRequestHTMLToMarkdown(presentation.FormatPullRequestDetailsMarkdown(d))).DontLog().RunWithOutput()
+	if err != nil {
+		return ""
+	}
+	return out
+}
+
+func (self *PullRequestsController) loadDetails(number int) {
+	if self.loadingDetails[number] {
+		return
+	}
+	self.loadingDetails[number] = true
+
+	width := self.c.Views().Main.InnerWidth()
+
+	self.c.OnWorker(func(gocui.Task) error {
+		d, err := self.c.Helpers().Refresh.FetchPullRequestDetails(number)
+		var rendered string
+		if err == nil {
+			rendered = self.renderDetails(d, width)
+		}
+		self.c.OnUIThread(func() error {
+			delete(self.loadingDetails, number)
+			if err != nil {
+				self.c.ErrorToast(err.Error())
+				return nil
+			}
+			if self.c.Model().PullRequestDetails == nil {
+				self.c.Model().PullRequestDetails = map[int]*models.GithubPullRequestDetails{}
+			}
+			self.c.Model().PullRequestDetails[number] = d
+			if rendered != "" {
+				self.renderedDetails[number] = rendered
+			}
+			if sel := self.context().GetSelected(); sel != nil && sel.Number == number {
+				self.context().HandleRenderToMain()
+			}
+			return nil
+		})
+		return nil
+	})
+}
+
+func (self *PullRequestsController) refreshDetails(pr *models.GithubPullRequest) error {
+	delete(self.c.Model().PullRequestDetails, pr.Number)
+	delete(self.renderedDetails, pr.Number)
+	self.context().HandleRenderToMain()
+	return nil
+}
+
+func (self *PullRequestsController) afterMutation(pr *models.GithubPullRequest, toast string) {
+	self.c.OnUIThread(func() error {
+		self.c.Toast(toast)
+		return self.refreshDetails(pr)
+	})
+}
+
+func (self *PullRequestsController) addComment(pr *models.GithubPullRequest) error {
+	return openCommentPanel(self.c, self.c.Tr.AddPullRequestComment, func(text string) error {
+		return self.sendComment(pr, text)
+	})
+}
+
+func (self *PullRequestsController) addCommentInEditor(pr *models.GithubPullRequest) error {
+	path, err := newCommentFile(self.c)
+	if err != nil {
+		return err
+	}
+	return commentInEditor(self.c, path, func(text string) error {
+		return self.sendComment(pr, text)
+	})
+}
+
+func (self *PullRequestsController) sendComment(pr *models.GithubPullRequest, text string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.SendingPullRequestComment, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.AddPullRequestComment(pr.NodeID, text); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestCommentSent)
+		return nil
+	})
+}
+
+// openCommentPanel reuses the commit message panel for a multiline comment.
+func openCommentPanel(c *ControllerCommon, title string, send func(body string) error) error {
+	c.Helpers().Commits.OpenCommitMessagePanel(&helpers.OpenCommitMessagePanelOpts{
+		CommitIndex:      context.NoCommitIndex,
+		SummaryTitle:     title,
+		DescriptionTitle: c.Tr.PullRequestCommentBodyTitle,
+		PreserveMessage:  false,
+		OnConfirm: func(summary string, description string) error {
+			if c.UserConfig().Git.Commit.AutoWrapCommitMessage {
+				description = helpers.TryRemoveHardLineBreaks(description, c.UserConfig().Git.Commit.AutoWrapWidth)
+			}
+			body := summary
+			if description != "" {
+				body = summary + "\n\n" + description
+			}
+			return send(body)
+		},
+		OnSwitchToEditor: func(path string) error {
+			return commentInEditor(c, path, send)
+		},
+	})
+	return nil
+}
+
+// commentInEditor edits the file in $EDITOR and sends its content.
+func commentInEditor(c *ControllerCommon, path string, send func(body string) error) error {
+	if err := c.Helpers().Files.EditFileAtLineAndWait(path, 1); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	_ = os.Remove(path)
+	text := strings.TrimSpace(string(data))
+	if text == "" {
+		return nil
+	}
+	return send(text)
+}
+
+func newCommentFile(c *ControllerCommon) (string, error) {
+	path := filepath.Join(c.OS().GetTempDir(), c.Git().RepoPaths.RepoName(), "pr-comment-"+time.Now().Format("20060102-150405.000000000")+".md")
+	return path, c.OS().CreateFileWithContent(path, "")
+}
+
+func (self *PullRequestsController) review(pr *models.GithubPullRequest) error {
+	return self.c.Menu(types.CreateMenuOptions{
+		Title: self.c.Tr.ReviewPullRequest,
+		Items: []*types.MenuItem{
+			{
+				Label: self.c.Tr.ApprovePullRequest,
+				OnPress: func() error {
+					self.c.Confirm(types.ConfirmOpts{
+						Title:  self.c.Tr.ReviewPullRequest,
+						Prompt: fmt.Sprintf(self.c.Tr.ConfirmApprovePullRequest, pr.Number),
+						HandleConfirm: func() error {
+							return self.submitReview(pr, "APPROVE", "")
+						},
+					})
+					return nil
+				},
+			},
+			{
+				Label: self.c.Tr.RequestChangesPullRequest,
+				OnPress: func() error {
+					self.c.Prompt(types.PromptOpts{
+						Title: self.c.Tr.RequestChangesBody,
+						HandleConfirm: func(text string) error {
+							if strings.TrimSpace(text) == "" {
+								return errors.New(self.c.Tr.RequestChangesBody)
+							}
+							return self.submitReview(pr, "REQUEST_CHANGES", text)
+						},
+					})
+					return nil
+				},
+			},
+		},
+	})
+}
+
+func (self *PullRequestsController) canMerge(pr *models.GithubPullRequest) *types.DisabledReason {
+	if pr.State != "OPEN" {
+		return &types.DisabledReason{Text: self.c.Tr.PullRequestNotOpen}
+	}
+	return nil
+}
+
+func (self *PullRequestsController) merge(pr *models.GithubPullRequest) error {
+	self.c.WithWaitingStatus(self.c.Tr.FetchingMergeMethods, func(gocui.Task) error {
+		methods, err := self.c.Helpers().Refresh.FetchPullRequestMergeMethods()
+		if err != nil {
+			return err
+		}
+		self.c.OnUIThread(func() error {
+			labels := map[string]string{
+				"MERGE":  self.c.Tr.MergeCommitMethod,
+				"SQUASH": self.c.Tr.SquashMergeMethod,
+				"REBASE": self.c.Tr.RebaseMergeMethod,
+			}
+			items := make([]*types.MenuItem, 0, len(methods))
+			for _, method := range methods {
+				label := labels[method]
+				items = append(items, &types.MenuItem{
+					Label: label,
+					OnPress: func() error {
+						self.c.Confirm(types.ConfirmOpts{
+							Title:  self.c.Tr.MergePullRequest,
+							Prompt: fmt.Sprintf(self.c.Tr.ConfirmMergePullRequest, pr.Number, label),
+							HandleConfirm: func() error {
+								return self.submitMerge(pr, method)
+							},
+						})
+						return nil
+					},
+				})
+			}
+			return self.c.Menu(types.CreateMenuOptions{
+				Title: self.c.Tr.MergePullRequest,
+				Items: items,
+			})
+		})
+		return nil
+	})
+	return nil
+}
+
+func (self *PullRequestsController) submitMerge(pr *models.GithubPullRequest, method string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.MergingPullRequest, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.MergePullRequest(pr.NodeID, method); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestMerged)
+		return self.c.Helpers().Refresh.RefreshOpenPullRequests()
+	})
+}
+
+func (self *PullRequestsController) viewCommits(pr *models.GithubPullRequest) error {
+	remote, _, err := self.c.Helpers().Refresh.GithubBase()
+	if err != nil {
+		return err
+	}
+
+	ref := &models.GithubPullRequestRef{Number: pr.Number, Title: pr.Title}
+
+	return self.c.WithWaitingStatus(self.c.Tr.FetchingPullRequest, func(task gocui.Task) error {
+		if err := self.c.Git().GitHub.FetchPullRequestRefCmdObj(task, remote.Name, pr.Number).Run(); err != nil {
+			return err
+		}
+
+		self.c.OnUIThread(func() error {
+			return self.c.Helpers().SubCommits.ViewSubCommits(helpers.ViewSubCommitsOpts{
+				Ref:             ref,
+				TitleRef:        ref.RefName() + " " + pr.Title,
+				Context:         self.context(),
+				ShowBranchHeads: true,
+			})
+		})
+		return nil
+	})
+}
+
+func (self *PullRequestsController) submitReview(pr *models.GithubPullRequest, event string, body string) error {
+	return self.c.WithWaitingStatus(self.c.Tr.SubmittingPullRequestReview, func(gocui.Task) error {
+		if err := self.c.Helpers().Refresh.SubmitPullRequestReview(pr.NodeID, event, body); err != nil {
+			return err
+		}
+		self.afterMutation(pr, self.c.Tr.PullRequestReviewSubmitted)
+		return nil
+	})
+}
+
+func (self *PullRequestsController) confirmOpenInBrowser(pr *models.GithubPullRequest) error {
+	self.c.Confirm(types.ConfirmOpts{
+		Title:  self.c.Tr.OpenPullRequestInBrowser,
+		Prompt: fmt.Sprintf(self.c.Tr.ConfirmOpenPullRequest, pr.Number),
+		HandleConfirm: func() error {
+			return self.openInBrowser(pr)
+		},
+	})
+	return nil
+}
+
+func (self *PullRequestsController) checkout(pr *models.GithubPullRequest) error {
+	remote, repo, err := self.c.Helpers().Refresh.GithubBase()
+	if err != nil {
+		return err
+	}
+
+	name := git_commands.PullRequestLocalBranchName(pr, repo.Owner)
+
+	if lo.ContainsBy(self.c.Model().Branches, func(branch *models.Branch) bool {
+		return branch.Name == name
+	}) {
+		return self.c.Helpers().Refs.CheckoutRef(name, types.CheckoutRefOptions{})
+	}
+
+	self.c.WithWaitingStatus(self.c.Tr.FetchingPullRequest, func(task gocui.Task) error {
+		self.c.LogAction(self.c.Tr.CheckoutPullRequestAction)
+
+		if err := self.c.Git().GitHub.FetchPullRequestCmdObj(task, remote.Name, pr.Number, name).Run(); err != nil {
+			return err
+		}
+
+		// CheckoutRef pushes the branches context, so it must run on the UI thread.
+		self.c.OnUIThread(func() error {
+			return self.c.Helpers().Refs.CheckoutRef(name, types.CheckoutRefOptions{})
+		})
+		return nil
+	})
+
+	return nil
+}
+
+func (self *PullRequestsController) openInBrowser(pr *models.GithubPullRequest) error {
+	self.c.LogAction(self.c.Tr.Actions.OpenPullRequest)
+
+	return self.c.OS().OpenLink(pr.Url)
+}
+
+func (self *PullRequestsController) detailsLoaded(pr *models.GithubPullRequest) *types.DisabledReason {
+	if self.c.Model().PullRequestDetails[pr.Number] == nil {
+		return &types.DisabledReason{Text: self.c.Tr.LoadingPullRequestDetails}
+	}
+	return nil
+}
+
+// openInEditor writes the details to lazygit's temp dir, which is removed on exit.
+func (self *PullRequestsController) openInEditor(pr *models.GithubPullRequest) error {
+	d := self.c.Model().PullRequestDetails[pr.Number]
+	path := filepath.Join(self.c.OS().GetTempDir(), self.c.Git().RepoPaths.RepoName(), fmt.Sprintf("pr-%d.md", pr.Number))
+	if err := self.c.OS().CreateFileWithContent(path, presentation.FormatPullRequestDetailsMarkdown(d)); err != nil {
+		return err
+	}
+	return self.c.Helpers().Files.EditFiles([]string{path})
+}
+
+func (self *PullRequestsController) copyURL(pr *models.GithubPullRequest) error {
+	self.c.LogAction(self.c.Tr.Actions.CopyPullRequestURL)
+	if err := self.c.OS().CopyToClipboard(pr.Url); err != nil {
+		return err
+	}
+
+	self.c.Toast(self.c.Tr.PullRequestURLCopiedToClipboard)
+
+	return nil
+}
+
+func (self *PullRequestsController) context() *context.PullRequestsContext {
+	return self.c.Contexts().PullRequests
+}
