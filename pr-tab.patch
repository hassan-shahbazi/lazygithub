+// PullRequestLineComment describes a comment on a PR diff. StartLine 0 means a single-line comment.
+type PullRequestLineComment struct {
+	CommitID  string
+	Path      string
+	Body      string
+	Line      int
+	StartLine int
+}
+
+func pullRequestLineCommentPayload(c PullRequestLineComment) map[string]any {
+	payload := map[string]any{
+		"body":      c.Body,
+		"commit_id": c.CommitID,
+		"path":      c.Path,
+		"line":      c.Line,
+		"side":      "RIGHT",
+	}
+	if 0 < c.StartLine && c.StartLine < c.Line {
+		payload["start_line"] = c.StartLine
+		payload["start_side"] = "RIGHT"
+	}
+	return payload
+}
+
+type restErrorResponse struct {
+	Message string          `json:"message"`
+	Errors  []restErrorItem `json:"errors"`
+}
+
+type restErrorItem struct {
+	Message string `json:"message"`
+}
+
+// UnmarshalJSON accepts either a plain string or an object with a message field.
+func (e *restErrorItem) UnmarshalJSON(data []byte) error {
+	var s string
+	if err := json.Unmarshal(data, &s); err == nil {
+		e.Message = s
+		return nil
+	}
+	var obj struct {
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(data, &obj); err != nil {
+		return err
+	}
+	e.Message = obj.Message
+	return nil
+}
+
+func parseRESTError(status string, body []byte) error {
+	var result restErrorResponse
+	if err := json.Unmarshal(body, &result); err != nil {
+		return fmt.Errorf("GitHub API error (%s): %s", status, string(body))
+	}
+
+	msg := result.Message
+	itemMessages := make([]string, 0, len(result.Errors))
+	for _, e := range result.Errors {
+		if e.Message != "" {
+			itemMessages = append(itemMessages, e.Message)
+		}
+	}
+	if len(itemMessages) > 0 {
+		msg = msg + ": " + strings.Join(itemMessages, "; ")
+	}
+	return fmt.Errorf("GitHub API error (%s): %s", status, msg)
+}
+
+// AddPullRequestLineComment adds a comment on a PR diff via the REST API.
+func (self *GitHubCommands) AddPullRequestLineComment(repo *hosting_service.ServiceInfo, number int, c PullRequestLineComment, token string) error {
+	bodyBytes, err := json.Marshal(pullRequestLineCommentPayload(c))
+	if err != nil {
+		return err
+	}
+
+	url := fmt.Sprintf("%s/repos/%s/%s/pulls/%d/comments", restEndpoint(repo.WebDomain), repo.Owner, repo.Repository, number)
+	req, err := http.NewRequest("POST", url, bytes.NewBuffer(bodyBytes))
+	if err != nil {
+		return err
+	}
+
+	req.Header.Set("Authorization", "token "+token)
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("Content-Type", "application/json")
+
+	client := &http.Client{}
+	resp, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return err
+	}
+
+	if resp.StatusCode == http.StatusCreated {
+		return nil
+	}
+	return parseRESTError(resp.Status, respBody)
+}
